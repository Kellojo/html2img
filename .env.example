# Where the SQLite database is stored.
DATABASE_PATH=./data/html2img.db

# Auth. Set APP_SECRET to a long random string (≥ 16 chars) to keep
# sessions stable across restarts. Run this to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset a secret is auto-generated next to the database on first start.
APP_SECRET=
ENABLE_SIGNUP=true
ENABLE_PASSWORD_LOGIN=true
AUTO_PROMOTE_FIRST_USER=true

# Server
PORT=3000
HOST=0.0.0.0
#ORIGIN=https://html2img.example.com

# Export rendering
EXPORT_CONCURRENCY=2
EXPORT_MAX_TIMEOUT_MS=10000

TZ=UTC
